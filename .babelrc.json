{
	"presets": [
		[
			"@babel/preset-env",
			{
				"modules": false,
				"targets": {
					"chrome": "100"
				}
			}
		],
		"@babel/preset-typescript"
	],
	"plugins": [
		"@babel/plugin-transform-class-properties",
		"@babel/plugin-transform-numeric-separator",
		"./scripts/babel-plugin-strip-exports.ts",
		"./scripts/babel-plugin-escape-non-ascii.ts",
		[
			"babel-plugin-transform-remove-imports",
			{
				"ignore": ["node_modules"],
				"removeAll": true,
				"test": "\\.(ts)$"
			}
		]
	]
}
